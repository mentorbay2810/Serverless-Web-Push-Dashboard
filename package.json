{
  "name": "serverless-web-push-dashboard",
  "version": "0.1.0-rc.3",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "setup": "tsx tools/setup.ts",
    "doctor": "tsx tools/doctor.ts",
    "local:unlock": "tsx tools/local-unlock.ts",
    "start": "node dist/tools/start.js",
    "release:check": "tsx tools/release-check.ts",
    "release:smoke": "node dist/tools/release-smoke.js",
    "release:package": "tsx tools/release-package.ts",
    "validate:local": "tsx tools/validate-local.ts",
    "dev": "tsx tools/dev.ts",
    "dev:queued": "tsx tools/dev.ts --queued",
    "dev:api": "tsx watch apps/functions/src/local-server.ts",
    "dev:web": "npm run dev --workspace @webpush/dashboard",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p apps/dashboard/tsconfig.json --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && npm run build --workspace @webpush/dashboard",
    "test": "tsx tools/test.ts",
    "benchmark": "npm run build && node dist/tools/benchmark/run.js",
    "benchmark:smoke": "node dist/tools/benchmark/run.js --audience 20 --repetitions 1 --warmup 0 --max-duration-ms 15000",
    "baseline": "node dist/tools/baseline/server.js",
    "research:run": "npm run build && node dist/tools/research/run.js",
    "research:smoke": "node dist/tools/research/run.js --smoke",
    "research:analyze": "node dist/tools/research/analyze.js",
    "research:plot": "python3 tools/research/plot.py",
    "push:list": "tsx tools/push.ts list",
    "push:send": "tsx tools/push.ts send",
    "campaigns": "tsx tools/campaigns.ts",
    "admin:login": "tsx tools/admin-login.ts",
    "check:cloud": "tsx tools/check-cloud.ts",
    "package:cloud": "tsx tools/package-cloud.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@types/node": "^22.19.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
