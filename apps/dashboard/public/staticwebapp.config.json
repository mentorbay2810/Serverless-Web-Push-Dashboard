{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/sw.js", "/*.{png,jpg,jpeg,svg,ico,json}"]
  },
  "routes": [
    { "route": "/sw.js", "headers": { "Cache-Control": "no-store" } },
    { "route": "/index.html", "headers": { "Cache-Control": "no-store" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
